# The public website uses no Google Maps or Places browser credentials.
# These server-only Google Business Profile values are examples of the names
# required by the private aggregate-rating sync. Never prefix them with
# NEXT_PUBLIC_ and never commit real values.
GBP_OAUTH_CLIENT_ID=
GBP_OAUTH_CLIENT_SECRET=
GBP_OAUTH_REFRESH_TOKEN=
GBP_LOCATION_RESOURCE=
